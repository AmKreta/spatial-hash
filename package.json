{
  "name": "@amk-utils/spatialhash",
  "version": "1.0.0",
  "description": "A uniform spatial hash grid for axis-aligned items in games, canvases, and maps.",
  "type": "module",
  "main": "./dist/spatialhash.cjs",
  "module": "./dist/spatialhash.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/spatialhash.js",
  "unpkg": "./dist/spatialhash.iife.js",
  "jsdelivr": "./dist/spatialhash.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/spatialhash.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/spatialhash.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AmKreta/spatial-hash.git"
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.cts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "spatial-hash",
    "spatial",
    "grid",
    "collision",
    "canvas",
    "games",
    "viewport"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
