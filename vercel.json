{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "docs/dist/spatialhash-docs/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "outputDirectory": "docs/dist/spatialhash-docs"
}
